# Copy to research-desk/.env; never commit credentials.
# Select anthropic (direct) or openrouter. Keys are not interchangeable.
RESEARCH_API_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
# Copy the exact model ID, including anthropic/, from OpenRouter's model page.
OPENROUTER_MODEL=
# Shared output cap for either provider: integer 1..1000.
ANTHROPIC_MAX_TOKENS=700
# Opt-in must be supplied on the command line; this value is ignored by the loader.
ALLOW_LOCAL_RESEARCH_API=0
