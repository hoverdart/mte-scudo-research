# Copy to .env (never commit the copy). The repository's .gitignore excludes .env files.
ANTHROPIC_API_KEY=
# Choose a supported low-cost model in your Anthropic account; no implicit default.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=700
# Must be set to 1 before any API request is made.
ALLOW_LOCAL_RESEARCH_API=0
